# Application
NODE_ENV=development
PORT=8001
# Public URL of this API, used to build short links (APP_URL/s/{code})
APP_URL=http://localhost:8001
# Nuxt / Next frontend, used for invite links and CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated; defaults to FRONTEND_URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=0
LOG_LEVEL=debug

# Database (see docker-compose.yml)
DATABASE_URL="postgresql://url_shortener:secret@localhost:5432/url_shortener?schema=public"

# Auth
BCRYPT_ROUNDS=12
# Personal access token lifetime in minutes; empty = never expires (Sanctum default)
TOKEN_EXPIRATION_MINUTES=

# Mail: "log" writes emails to the log, "smtp" sends them
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=UrlShortner
